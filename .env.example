# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — NEVER commit real keys.
#
# These are the PUBLIC (publishable / anon) Supabase client values.
# They are safe to expose in a frontend because Supabase Row Level Security
# (RLS) controls what they can do. NEVER put the service_role key here.

VITE_SUPABASE_URL=your_project_url_here
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key_here
